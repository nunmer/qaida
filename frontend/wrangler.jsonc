{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qaida-party",
  "main": "party/server.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
