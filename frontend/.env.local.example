# Google Maps JS API key (Street View). Without it the game falls back to photos.
# Enable "Maps JavaScript API" + "Street View Static API" is NOT needed — only the JS API.
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Realtime host for "Play with friends" rooms (partyserver on Cloudflare Workers).
# Local dev: leave unset (defaults to 127.0.0.1:8787, run `npm run party:dev`).
# Production: set to your deployed worker, e.g. qaida-party.<subdomain>.workers.dev
NEXT_PUBLIC_PARTY_HOST=
