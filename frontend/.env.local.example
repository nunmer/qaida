# Google Maps JS API key (Street View). Without it the game falls back to photos.
# Enable "Maps JavaScript API" + "Street View Static API" is NOT needed — only the JS API.
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PartyKit host for "Play with friends" multiplayer rooms.
# Local dev: leave unset (defaults to 127.0.0.1:1999, run `npm run party:dev`).
# Production: set to your deployed worker, e.g. qaida.<username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=
